{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "mcp": {
    "nixos": {
      "type": "local",
      "command": ["uvx", "mcp-nixos"],
      "enabled": true
    }
  },
  "agent": {},
  "mode": {},
  "plugin": [],
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "sort *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "sed *": "allow",
      "echo *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".npmrc": "deny",
      "auth.json": "deny"
    }
  }
}

// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "font": {
      "rendering": "native",
      "normal": {
         "family": "Noto Sans",
         "size": 11
      }
   },
   "theme": {
      "light": {
         "name": "catppuccin-latte"
      },
      "dark": {
         "name": "catppuccin-latte"
      }
   },
   "launcher_window": {
      "opacity": 1,
      "client_side_decorations": {
         "enabled": false
      },
      "compact_mode": {
         "enabled": false
      },
      "floating_status_bar": true,
      "material": "blur"
   },
   "providers": {
      "@gebeto/store.raycast.translate": {
         "preferences": {
            "autoInput": true,
            "defaultAction": "copy",
            "lang1": "en",
            "lang2": "pl",
            "langFrom": "auto",
            "prioritizeCrossLanguage": true
         },
         "entrypoints": {
            "instant-translate-copy": {
               "enabled": false
            },
            "instant-translate-paste": {
               "enabled": false
            },
            "instant-translate-view": {
               "enabled": false
            }
         }
      },
      "@khasbilegt/store.raycast.1password": {
         "preferences": {
            "version": "v8",
            "closeWindowAfterCopying": true,
            "primaryAction": "open-in-1password",
            "reduceItemListMemoryUsage": false,
            "secondaryAction": "open-in-browser",
            "zshPath": "/bin/zsh",
            "cliPath": "/run/wrappers/bin/op"
         }
      },
      "@tegola/store.raycast.remove-paywall": {
         "preferences": {
            "service": "https://www.removepaywall.com"
         }
      },
      "@thomaslombart/store.raycast.linear": {
         "entrypoints": {
            "create-project": {
               "enabled": false
            },
            "search-custom-views": {
               "enabled": false
            },
            "search-documents": {
               "enabled": false
            },
            "search-projects": {
               "enabled": false
            }
         }
      },
      "core": {
         "entrypoints": {
            "keybind-settings": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": false
            },
            "open-default-config": {
               "enabled": false
            },
            "search-builtin-icons": {
               "enabled": false
            },
            "search-emojis": {
               "preferences": {
                  "defaultAction": "paste",
                  "skinTone": "medium-light"
               }
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "font": {
         "entrypoints": {
            "browse": {
               "enabled": false
            }
         }
      },
      "media": {
         "entrypoints": {
            "toggle-mute": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "power": {
         "entrypoints": {
            "sleep": {
               "enabled": false
            }
         }
      },
      "system": {
         "entrypoints": {
            "set-default-terminal": {
               "enabled": false
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "theme": {
         "entrypoints": {
            "set": {
               "enabled": false
            }
         }
      }
   }
}